# ---- Required ----
# Get one at https://serpapi.com (free tier available)
SERP_API_KEY=your_serpapi_key_here
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# ---- Optional ----
# Embeddings for the RAG baseline (the app runs fine without it).
# OPENAI_API_KEY=your_openai_key_here
# Redis for the llm_optimizer semantic cache (legacy path only; not required).
# REDIS_URL=redis://localhost:6379/0
# Transactional email (password resets). Not needed for the demo.
# RESEND_API_KEY=your_resend_key_here

# ---- Production only ----
# Generate with: bin/rails secret
# SECRET_KEY_BASE=
# CREDCHECK_DATABASE_PASSWORD=
