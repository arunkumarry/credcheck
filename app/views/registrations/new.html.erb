<div class="flex min-h-screen flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-slate-900">Create a new account</h2>
    <p class="mt-2 text-center text-sm text-slate-600">
      Or
      <%= link_to "sign in to your existing account", new_session_path, class: "font-medium text-orange-500 hover:text-orange-400" %>
    </p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10 border border-slate-100">
      <%= render "form", user: @user %>
    </div>
  </div>
</div>