<%= turbo_frame_tag "dashboard_content" do %>
  <div class="bg-white shadow-sm ring-1 ring-slate-200 sm:rounded-lg overflow-hidden max-w-md mx-auto">
    <div class="border-b border-slate-200 bg-orange-500 px-4 py-5 sm:px-6">
      <h3 class="text-base font-semibold leading-6 text-white">Add a New Card</h3>
    </div>
    
    <div class="px-4 py-5 sm:p-6">
      <%= form_with url: user_cards_path, class: "space-y-4" do |form| %>
        <div>
          <label for="bank_id" class="block text-sm font-medium leading-6 text-slate-900">Select Bank</label>
          <div class="mt-2">
            <%= select_tag :bank_id, 
                  options_from_collection_for_select(@available_banks, "id", "name", params[:bank_id]), 
                  prompt: "Choose a bank...",
                  required: true,
                  data: { controller: "bank-select", action: "change->bank-select#update" },
                  class: "block w-full rounded-md border-0 py-2.5 pl-3 pr-10 text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-orange-500 sm:text-sm sm:leading-6" %>
          </div>
        </div>

        <%= turbo_frame_tag "cards_dropdown" do %>
          <div>
            <label for="card_id" class="block text-sm font-medium leading-6 text-slate-900">Select Card</label>
            <div class="mt-2">
              <%= select_tag :card_id, 
                    options_from_collection_for_select(@cards, "id", "name"), 
                    prompt: @cards.any? ? "Choose a card..." : "Choose a bank first...",
                    required: true,
                    disabled: @cards.empty?,
                    class: "block w-full rounded-md border-0 py-2.5 pl-3 pr-10 text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-orange-500 sm:text-sm sm:leading-6 disabled:bg-slate-50 disabled:text-slate-500" %>
            </div>
          </div>
        <% end %>
        <div class="pt-2">
          <%= form.submit "Add to Wallet", class: "flex w-full justify-center rounded-md bg-slate-900 px-3 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900 transition-colors cursor-pointer disabled:opacity-50", disabled: @available_banks.empty? %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
