<%= turbo_stream.remove dom_id(@user_card, :sidebar) %>
<%= turbo_stream.update "dashboard_content" do %>
  <div class="text-center rounded-2xl bg-white border border-slate-100 shadow-sm p-12 max-w-2xl mx-auto">
    <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-slate-100 mb-4">
      <svg class="h-8 w-8 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
    </div>
    <h2 class="mt-4 text-xl font-bold text-slate-900">Card Removed</h2>
    <p class="mt-2 text-sm text-slate-500">The card has been successfully removed from your wallet.</p>
  </div>
<% end %>
<%= turbo_stream.update "flash_messages", partial: "shared/flash" %>
