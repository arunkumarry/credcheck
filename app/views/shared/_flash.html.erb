<div id="flash_messages">
  <% if notice %>
    <div data-controller="flash" class="fixed top-4 left-1/2 -translate-x-1/2 z-[100] rounded-lg bg-green-50 px-4 py-3 text-sm text-green-800 shadow-md ring-1 ring-green-600/20 transition-all duration-500" role="alert">
      <%= notice %>
    </div>
  <% end %>

  <% if alert %>
    <div data-controller="flash" class="fixed top-4 left-1/2 -translate-x-1/2 z-[100] rounded-lg bg-red-50 px-4 py-3 text-sm text-red-800 shadow-md ring-1 ring-red-600/20 transition-all duration-500" role="alert">
      <%= alert %>
    </div>
  <% end %>
</div>
