<%= turbo_frame_tag "dashboard_content" do %>
  <div class="bg-white shadow-sm ring-1 ring-slate-200 sm:rounded-lg overflow-hidden max-w-2xl mx-auto">
    <div class="border-b border-slate-200 bg-slate-50 px-4 py-5 sm:px-6">
      <h3 class="text-base font-semibold leading-6 text-slate-900">My Profile</h3>
    </div>
    <div class="px-4 py-5 sm:p-6">
      <dl class="divide-y divide-slate-100">
        <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
          <dt class="text-sm font-medium leading-6 text-slate-900">Full name</dt>
          <dd class="mt-1 text-sm leading-6 text-slate-700 sm:col-span-2 sm:mt-0"><%= Current.user.first_name %> <%= Current.user.last_name %></dd>
        </div>
        <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
          <dt class="text-sm font-medium leading-6 text-slate-900">Email address</dt>
          <dd class="mt-1 text-sm leading-6 text-slate-700 sm:col-span-2 sm:mt-0"><%= Current.user.email_address %></dd>
        </div>
        <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
          <dt class="text-sm font-medium leading-6 text-slate-900">Member since</dt>
          <dd class="mt-1 text-sm leading-6 text-slate-700 sm:col-span-2 sm:mt-0"><%= Current.user.created_at.strftime("%B %d, %Y") %></dd>
        </div>
        <div class="px-4 py-6 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-0">
          <dt class="text-sm font-medium leading-6 text-slate-900">API Token</dt>
          <dd class="mt-1 text-sm leading-6 text-slate-700 sm:col-span-2 sm:mt-0">
            <div class="flex items-center gap-2">
              <code class="px-2 py-1 bg-slate-100 rounded text-slate-800 font-mono text-xs select-all"><%= Current.user.api_token || "Run db:migrate to generate" %></code>
              <span class="text-xs text-slate-500">(Use this in the Chrome Extension)</span>
            </div>
          </dd>
        </div>
      </dl>
    </div>
  </div>
<% end %>
